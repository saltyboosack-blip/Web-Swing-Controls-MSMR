<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Properties\Resources\icon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Authors>Tkachov</Authors>
    <AssemblyVersion>1.4.5.1</AssemblyVersion>
    <FileVersion>1.4.5.1</FileVersion>
    <InformationalVersion>1.4.5.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Modding Tool - MSMR Script Add-on</Product>
    <Description>Unofficial GPL add-on that safely installs MSMR .script packages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Properties\Resources\icon.ico" />
    <EmbeddedResource Include="NativePayload\scripts_proxy.dll" LogicalName="ModdingTool.NativePayload.scripts_proxy.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WindowsAPICodePack-Shell" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DAT1\DAT1.csproj" />
    <ProjectReference Include="..\ModdingToolScriptSupportCore\ModdingToolScriptSupportCore.csproj" />
    <ProjectReference Include="..\OverstrikeShared\OverstrikeShared.csproj" />
  </ItemGroup>

</Project>
